  "cards": [
    {
      "dot": "cyan",
      "title": "FOH flow",
      "items": [
        "Guest uses a QR flow without an app or login.",
        "The QR edge exposes only the current queue/table session.",
        "Staff acknowledgement remains the hospitality fallback."
      ]
    },
    {
      "dot": "emerald",
      "title": "BOH flow",
      "items": [
        "Purchasing and goods receipt feed warehouse stock.",
        "Branch requests move through approval, shipment and closure.",
        "Daily count and wastage preserve variance and value evidence."
      ]
    },
    {
      "dot": "rose",
      "title": "Safety boundaries",
      "items": [
        "PostgreSQL owns business state; Redis is never authoritative.",
        "Stock mutations use a transaction, append-only ledger and audit event.",
        "AI cannot directly mutate queue, stock, PO, wastage or payment."
      ]
    }
  ]
